###########################
### Window / Workspace  ###
### Navigation          ###
###########################

# Move focus between windows
bindsym $mod+$down   focus down
bindsym $mod+$left   focus left
bindsym $mod+$right  focus right
bindsym $mod+$up     focus up

# Move windows around
bindsym $smod+$down   move down
bindsym $smod+$left   move left
bindsym $smod+$right  move right
bindsym $smod+$up     move up

bindsym $mod+a   focus parent
bindsym $smod+a  focus child

# Switch to workspace
bindsym $mod+quotedbl  workspace number $ws0
bindsym $mod+1         workspace number $ws1
bindsym $mod+2         workspace number $ws2
bindsym $mod+3         workspace number $ws3
bindsym $mod+4         workspace number $ws4
bindsym $mod+5         workspace number $ws5
bindsym $mod+6         workspace number $ws6
bindsym $mod+7         workspace number $ws7
bindsym $mod+8         workspace number $ws8
bindsym $mod+9         workspace number $ws9

# Move window to workspace and follow
bindsym $smod+quotedbl  move container to workspace number $ws0 ;  workspace number $ws0
bindsym $smod+1         move container to workspace number $ws1 ;  workspace number $ws1
bindsym $smod+2         move container to workspace number $ws2 ;  workspace number $ws2
bindsym $smod+3         move container to workspace number $ws3 ;  workspace number $ws3
bindsym $smod+4         move container to workspace number $ws4 ;  workspace number $ws4
bindsym $smod+5         move container to workspace number $ws5 ;  workspace number $ws5
bindsym $smod+6         move container to workspace number $ws6 ;  workspace number $ws6
bindsym $smod+7         move container to workspace number $ws7 ;  workspace number $ws7
bindsym $smod+8         move container to workspace number $ws8 ;  workspace number $ws8
bindsym $smod+9         move container to workspace number $ws9 ;  workspace number $ws9

workspace_auto_back_and_forth no


##################################
### Window Management / Layout ###
##################################

bindsym $smod+d      kill
bindsym --whole-window $mod+button2  kill

bindsym $smod+space  floating toggle
bindsym $mod+space   focus mode_toggle
bindsym $mod+f       fullscreen toggle
bindsym $mod+e       layout toggle split
bindsym $mod+w       layout tabbed
# bindsym $mod+s     layout stacking
bindsym $mod+v       split toggle

# sticky floating "always on top" placement
bindsym $mod+y  fullscreen disable; floating enable; resize set 422 240; sticky enable; move position 870 25

# Resizing by 1px/1ppt
bindsym $mod+control+$right  resize grow width 1 px or 1 ppt
bindsym $mod+control+$left   resize shrink width 1 px or 1 ppt
bindsym $mod+control+$up     resize shrink height 1 px or 1 ppt
bindsym $mod+control+$down   resize grow height 1 px or 1 ppt

default_floating_border pixel 2
default_orientation auto
for_window [class=".*"] border pixel 3

floating_maximum_size -1 x -1
floating_minimum_size 75 x 50
floating_modifier $mod
focus_follows_mouse yes
focus_on_window_activation smart
gaps inner 5
gaps outer 13
no_focus [window_role="pop-up"]
popup_during_fullscreen smart
smart_borders on
smart_gaps on
font $wm_setting_font


############################
### Apps & Launchers     ###
############################

bindsym $mod+Return    exec --no-startup-id $terminal
bindsym $mod+t         exec --no-startup-id $terminal
bindsym mod1+shift+t   exec --no-startup-id $terminal --class floating_alacritty -e tmux

bindsym $mod+b         exec --no-startup-id $browser
bindsym $smod+Return   exec --no-startup-id $browser

bindsym $mod+d  exec --no-startup-id "rofi -modi drun,run -show drun"
bindsym $mod+z  exec --no-startup-id rofi -show blezz -modi blezz -auto-select -matching normal -blezz-config ~/.config/blezz/main.config

bindsym $mod+x  exec --no-startup-id /home/$USER/.config/scripts/lock


##################################
### Media, Audio & Brightness  ###
##################################

bindsym XF86AudioPlay   exec --no-startup-id playerctl play-pause
bindsym XF86AudioPause  exec --no-startup-id playerctl pause
bindsym XF86AudioStop   exec --no-startup-id playerctl stop
bindsym XF86AudioNext   exec --no-startup-id playerctl next
bindsym XF86AudioPrev   exec --no-startup-id playerctl previous

bindsym XF86AudioLowerVolume  exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 3%-
bindsym XF86AudioRaiseVolume  exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 4%+
bindsym XF86AudioMute         exec --no-startup-id wpctl set-sink-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioMicMute      exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SOURCE@

bindsym XF86MonBrightnessDown  exec --no-startup-id brightnessctl set 4%-
bindsym XF86MonBrightnessUp    exec --no-startup-id brightnessctl set +4%

# Screen Rotation
bindsym $mod+Up     exec --no-startup-id xrandr --output eDP-1 --rotate normal
bindsym $mod+Down   exec --no-startup-id xrandr --output eDP-1 --rotate inverted
bindsym $mod+Right  exec --no-startup-id xrandr --output eDP-1 --rotate right
bindsym $mod+Left   exec --no-startup-id xrandr --output eDP-1 --rotate left


#####################
### Screenshots   ###
#####################

exec_always --no-startup-id xmodmap -e "keycode 84 = Down"

bindsym --release Print         exec --no-startup-id escrotum --select --clipboard
bindsym --release Shift+Print   exec --no-startup-id escrotum --clipboard
bindsym --release $mod+m        exec --no-startup-id scrot -s '/tmp/%F_%T_$wx$h.png' -e 'xclip -selection clipboard -target image/png -i $f'
bindsym --release $mod+Shift+m  exec --no-startup-id "scrot ~/Pictures/screenshots/custom/$(date +%F-%H%M%S).png -s -e 'xclip -selection c -t image/png < $f' ; notify-send 'Screenshot (custom) saved' -t 1"
bindsym --release $mod+p        exec --no-startup-id import /tmp/latest-screenshot.png

