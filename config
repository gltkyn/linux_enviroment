############################
### System / Session     ###
############################

bindsym $smod+q  exec --no-startup-id "i3-msg exit"
# bindsym $smod+e exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -B 'Yes, exit i3' 'i3-msg exit'"
bindsym $smod+r  restart
# bindsym $smod+c reload

bindsym $mod+s   exec --no-startup-id bluetoothctl connect C4:16:88:A2:DA:D2
bindsym $smod+s  exec --no-startup-id bluetoothctl disconnect C4:16:88:A2:DA:D2

bindsym $mod+c   exec --no-startup-id caffeinate
bindsym $smod+c  exec --no-startup-id pkill caffeinate

bindsym $mod+Shift+ç  exec --no-startup-id ~/.local/bin/toggle_alastor.sh
bindsym XF86Launch1   exec --no-startup-id ~/bin/diary-entry.sh


##########################
### Window Rules       ###
##########################

for_window [instance="floating_alacritty"] floating enable

# Desktop Pet Rules
for_window [instance="rust_pet"] floating enable
for_window [instance="rust_pet"] border none
for_window [instance="rust_pet"] sticky enable
for_window [instance="rust_pet"] no_focus

# This catches most Wine games and forces them to float
for_window [id="wine"] floating enable
for_window [instance="wine"] floating enable

for_window [title="letter-pet"] floating enable, border none, sticky enable, focus disabled
for_window [instance="diary-float"] floating enable, resize set 700 500, move position center


